#@window_width = 550
@window_width = 490
@chairman_text_x = 147
@other_guys_text_x = 50
#@cabinet_first_row_y = 159
@cabinet_first_row_y = 129
guiTypes = {
	containerwindowtype = {
		name = "RUS_cabinet_gui_container"
		size = { width = @window_width height = 312 }
		show_sound = open_sub_window
		click_to_front = yes

		instantTextBoxType = {
			name = "RUS_cabinet_title"
			position = { x = 50 y = -10 }
			font = "hoi_24header"
			text = "RUS_cabinet_title_tt"
			maxWidth = 400
			maxHeight = 24
			format = center
		}

		instantTextBoxType = {
			name = "RUS_cabinet_desc"
			#position = { x = 14 y = 50 }
			position = { x = 50 y = 20 }
			font = "hoi_16mbs"
			text = "RUS_cabinet_desc_tt"
			#maxWidth = 510
			maxWidth = 400
			format = center
		}

		containerWindowType = {
			name = "RUS_cabinet_chairman"
			position = { x = 10 y = @cabinet_first_row_y }
			orientation = UPPER_LEFT
			iconType = {
				name = "RUS_cabinet_chairman_icon"
				spriteType = ""
				position = { x = 20 y = 0 }
				# maxWidth = 152
				# maxHeight = 210
				pdx_tooltip = "RUS_cabinet_chairman_tt"
				pdx_tooltip_delayed = RUS_cabinet_chairman_lore_tt
				scale = 0.74
			}
			iconType = {
				name = "RUS_cabinet_leader_frame"
				position = { x = 11 y = -7 }
				spriteType = "GFX_diplo_leader_frame"
				alwaystransparent = yes
				pdx_tooltip = "RUS_cabinet_chairman_tt"
				pdx_tooltip_delayed = RUS_cabinet_chairman_lore_tt
			}
			instantTextBoxType = {
				name = "RUS_cabinet_chairman_title"
				position = { x = @chairman_text_x y = -12 }
				font = "hoi_24header"
				text = "RUS_cabinet_chairman_title_tt"
				pdx_tooltip = "RUS_cabinet_chairman_title_desc"
				pdx_tooltip_delayed = RUS_cabinet_chairman_lore_tt
